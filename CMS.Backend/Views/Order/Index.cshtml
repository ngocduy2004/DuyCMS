@model List<CMS.Data.Entities.Order>
@{
    Layout = "_LayoutAdmin";
}


<div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-dark font-weight-bold m-0 text-uppercase">BÀI TẬP 6: LIỆT KÊ DANH SÁCH ORDERS</h3>
        <button class="btn btn-dark btn-sm">+ Tạo đơn hàng mới</button>
    </div>

    <table class="table table-bordered table-striped table-hover align-middle shadow-sm bg-white">
        <thead class="table-dark text-white">
            <tr>
                <th style="width: 60px;" class="text-center">ID</th>
                <th style="width: 200px;">Khách Hàng</th>
                <th style="width: 150px;">Ngày Đặt</th>
                <th style="width: 120px;" class="text-center">Tổng Tiền</th>
                <th style="width: 140px;" class="text-center">Trạng Thái</th>
                <th>Ghi Chú</th>
                <th class="text-center" style="width: 180px;">Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center font-weight-bold text-secondary">#@item.Id</td>

                        <td>
                            <strong class="text-primary">@(item.Customer?.FullName ?? "Khách vãng lai")</strong>
                            <br />
                            <small class="text-muted">SĐT: @(item.Customer?.Phone ?? "Không có")</small>
                        </td>

                        <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>

                        <td class="text-center font-weight-bold text-danger">
                            @(item.OrderDetails?.Sum(d => d.UnitPrice * d.Quantity).ToString("N0") ?? "0") đ
                        </td>

                        <td class="text-center">
                            @if (item.Status == 0)
                            {
                                <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                            }
                            else if (item.Status == 1)
                            {
                                <span class="badge bg-primary">Đang xử lý</span>
                            }
                            else if (item.Status == 2)
                            {
                                <span class="badge bg-success">Đã giao</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Đã hủy</span>
                            }
                        </td>

                        <td class="text-muted small">@item.Notes</td>

                        <td class="text-center">
                            @if (item.Status == 0)
                            {
                                <a asp-action="Confirm" asp-route-id="@item.Id"
                                   class="btn btn-success btn-sm py-0 px-2 text-white me-1 mb-1"
                                   onclick="return confirm('Bạn muốn xác nhận đơn hàng này?');">
                                    Xác nhận
                                </a>
                            }
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm py-0 px-2 text-dark me-1 mb-1">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm py-0 px-2 text-white mb-1"
                               onclick="return confirm('Bạn có chắc chắn muốn xóa đơn hàng này?');">
                                Xóa
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        <i class="fa-solid fa-box-open fs-3 d-block mb-2"></i>
                        Chưa có dữ liệu đơn hàng nào. Hãy kiểm tra hoặc nạp thêm trong SQL Server!
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>