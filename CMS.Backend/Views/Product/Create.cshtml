@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Thêm mới Sản phẩm";
}

<div class="container mt-4">
    <h3 class="text-uppercase text-success font-weight-bold mb-3">Thêm Mới Sản Phẩm</h3>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Name" class="control-label font-weight-bold">Tên Sản Phẩm <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm..." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="Price" class="control-label font-weight-bold">Giá Bán (VNĐ)</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="StockQuantity" class="control-label font-weight-bold">Tồn Kho</label>
                        <input asp-for="StockQuantity" type="number" class="form-control" />
                        <span asp-validation-for="StockQuantity" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="CategoryProductId" class="control-label font-weight-bold">Danh Mục Sản Phẩm</label>
                    <select asp-for="CategoryProductId" class="form-control" asp-items="ViewBag.CategoryList">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                    <span asp-validation-for="CategoryProductId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label font-weight-bold">Hình Ảnh Sản Phẩm</label>
                    <input type="file" id="ImageUpload" name="ImageFile" class="form-control" accept="image/*" />
                    <small class="text-muted">Chọn ảnh từ thiết bị của bạn.</small>

                    <div class="mt-3">
                        <img id="ImagePreview" src="" alt="Ảnh xem trước" class="img-thumbnail" style="max-height: 200px; display: none;" />
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Description" class="control-label font-weight-bold">Mô Tả Sản Phẩm</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-success px-4">Lưu Sản Phẩm</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Quay Lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById('ImageUpload').addEventListener('change', function (event) {
            const file = event.target.files[0]; // Lấy file đầu tiên người dùng chọn
            const preview = document.getElementById('ImagePreview'); // Lấy thẻ img preview

            if (file) {
                // Tạo một URL tạm thời cho file ảnh và gán vào src của thẻ img
                preview.src = URL.createObjectURL(file);
                preview.style.display = 'block'; // Hiển thị thẻ img
            } else {
                // Nếu người dùng hủy chọn, ẩn thẻ img đi
                preview.src = '';
                preview.style.display = 'none';
            }
        });
    </script>
}