@model IEnumerable<CMS.Data.Entities.Post>
@{
    Layout = "_LayoutAdmin";
}

<div class="container-fluid mt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold">DANH SÁCH BÀI VIẾT</h2>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle"></i> Thêm bài viết mới
        </a>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail"
                         style="height: 180px; object-fit: cover; width: 100%;">

                    <div class="card-body d-flex flex-column">
                        <div class="mb-2">
                            <span class="badge bg-info text-dark fw-normal">@item.Category?.Name</span>
                        </div>
                        <h5 class="card-title text-primary fw-bold text-truncate" title="@item.Title">@item.Title</h5>
                        <p class="card-text text-muted small text-truncate flex-grow-1">@item.Content</p>
                        <p class="text-secondary card-text fs-7 mb-3">
                            <i class="bi bi-calendar3"></i> @item.CreatedDate.ToString("dd/MM/yyyy")
                        </p>

                        <div class="d-flex justify-content-between gap-1 mt-auto pt-2 border-top">
                            <a href="/Post/Details/@item.Id" class="btn btn-xs btn-outline-primary flex-fill text-nowrap">Xem</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-xs btn-outline-warning flex-fill text-nowrap">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('Chúng ta có chắc chắn muốn xóa bài viết này không?')">
                                <i class="bi bi-trash"></i> Xóa
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>