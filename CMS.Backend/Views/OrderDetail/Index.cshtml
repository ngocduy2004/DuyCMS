@model List<CMS.Data.Entities.OrderDetail>
@{
    Layout = "_LayoutAdmin";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-dark font-weight-bold m-0 text-uppercase">LIỆT KÊ DANH SÁCH ORDER DETAILS</h3>
        <span class="badge bg-secondary p-2">Dữ liệu hệ thống</span>
    </div>

    <table class="table table-bordered table-striped table-hover align-middle shadow-sm bg-white">
        <thead class="table-dark text-white">
            <tr>
                <th style="width: 80px;" class="text-center">ID</th>
                <th class="text-center" style="width: 150px;">Mã Đơn Hàng</th>
                <th>Sản Phẩm</th>
                <th class="text-center" style="width: 120px;">Số Lượng</th>
                <th class="text-end" style="width: 180px;">Đơn Giá</th>
                <th class="text-end" style="width: 180px;">Thành Tiền</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                // 1. NHÓM CÁC CHI TIẾT ĐƠN HÀNG LẠI THEO MÃ ĐƠN HÀNG (OrderId)
                var groupedDetails = Model.GroupBy(x => x.OrderId).ToList();

                foreach (var group in groupedDetails)
                {
                    // Lấy số lượng sản phẩm trong đơn hàng này để gộp dòng (rowspan)
                    int rowSpan = group.Count();
                    bool isFirstRowOfOrder = true;

                    foreach (var item in group)
                    {
                        var totalRow = item.Quantity * item.UnitPrice;

                        <tr>
                            <td class="text-center font-weight-bold text-secondary">@item.Id</td>

                            @* 2. CHỈ IN CỘT MÃ ĐƠN HÀNG Ở DÒNG ĐẦU TIÊN CỦA NHÓM, VÀ GỘP CÁC DÒNG XUỐNG DƯỚI *@
                            @if (isFirstRowOfOrder)
                            {
                                <td class="text-center align-middle" rowspan="@rowSpan" style="background-color: #f8f9fa;">
                                    <a href="/Order/Index" class="text-decoration-none text-primary fw-bold fs-5 d-block">#@item.OrderId</a>
                                    <span class="badge bg-info mt-2">@rowSpan sản phẩm</span>
                                </td>
                            }

                            <td>
                                <strong class="text-success">@(item.Product?.Name ?? "Sản phẩm đã bị xóa")</strong>
                                <br />
                                <small class="text-muted">Mã SP: #@item.ProductId</small>
                            </td>

                            <td class="text-center font-weight-bold">@item.Quantity</td>
                            <td class="text-end text-muted">@item.UnitPrice.ToString("N0") đ</td>
                            <td class="text-end text-danger font-weight-bold">@totalRow.ToString("N0") đ</td>
                        </tr>

                        // Đánh dấu đã in xong dòng đầu tiên
                        isFirstRowOfOrder = false;
                    }
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        <i class="fa-solid fa-box-open fs-3 d-block mb-2"></i>
                        Chưa có dữ liệu chi tiết đơn hàng nào. Hãy nạp thêm trong SQL Server!
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>